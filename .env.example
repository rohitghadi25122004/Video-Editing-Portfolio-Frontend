# Public origin of the deployed site, used for canonical, Open Graph,
# sitemap and JSON-LD URLs. Not needed on Vercel (its production domain is
# picked up automatically). Example: https://vasantgawade.com
NEXT_PUBLIC_SITE_URL=

# Backend that serves the live video list (GET /api/content). Leave empty to
# show only the list built in from content/vasant.json.
# Example: https://api.vasantgawade.com
NEXT_PUBLIC_API_URL=
